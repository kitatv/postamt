# Choose MySQL or SQLite (relative SQLite paths use the instance directory).
# DATABASE_URL=sqlite:///postamt.db
DATABASE_URL=mysql+pymysql://postamt:CHANGE_ME@127.0.0.1:3306/postamt?charset=utf8mb4
SECRET_KEY=GENERATE_A_RANDOM_SECRET
MAIL_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
# Only for local development over HTTP; production must use 1 and HTTPS.
COOKIE_SECURE=0
# For the optional local MySQL container; use independent random passwords.
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO
